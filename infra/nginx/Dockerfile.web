# ---- build stage: next export ----
FROM node:20-alpine AS build
WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build
# output: "export" 설정이면 보통 /app/out 생성됨

# ---- runtime stage: nginx only (single process) ----
FROM nginx:1.27-alpine
COPY infra/nginx/stage.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/out /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]